<div class="del-dashboard-container">
  <h1 class="del-dashboard-title">Dashboard</h1>
<% if (role === 'creator') { %>
<!-- CREATOR DASHBOARD -->
<div class="del-balance-card">
  <h2 class="del-balance-title">Available Balance</h2>
  <div class="del-balance-amount">₦<span id="availableBalance"><%= totalEarnings %></span></div>
  <button class="del-fund-wallet-btn">
    <span class="del-wallet-icon">💰</span>
    Withdraw Funds
  </button>
</div>

<div class="del-stats-row">
  <div class="del-stats-card">
    <div class="del-amount">₦<%= totalSubscription %></div>
    <div class="del-label">Total Subscription Revenue</div>
    <div class="del-trend"><span class="del-trend-icon">↗</span> 0% Today</div>
  </div>
  
  <div class="del-stats-card">
    <div class="del-amount">₦<%= totalSpecial %></div>
    <div class="del-label">Total Special Content Revenue</div>
    <div class="del-trend"><span class="del-trend-icon">↗</span> 0% Today</div>
  </div>
  
  <div class="del-stats-card">
    <div class="del-amount">₦<%= totalTips %></div>
    <div class="del-label">Total Tips Received</div>
    <div class="del-trend"><span class="del-trend-icon">↗</span> 0% Today</div>
  </div>
  
  <div class="del-stats-card del-total-card">
    <div class="del-amount">₦<%= totalSubscription + totalSpecial + totalTips %></div>
    <div class="del-label">Total Gross Revenue</div>
    <div class="del-trend"><span class="del-trend-icon">↗</span> 0% Today</div>
  </div>
</div>

<!-- Referral Link -->
<div class="del-referral-link">
  <a href="/referrals" class="del-referral-btn">View Referral Earnings</a>
</div>

<!-- Banks Section -->
<div class="del-section">
  <h2 class="del-section-title">Your Saved Banks</h2>
  
 <div class="del-banks-list">
  <% if (user.banks && user.banks.length > 0) { %>
    <% user.banks.forEach((bank, idx) => { %>
      <div class="del-bank-item">
        <div class="del-bank-icon">🏦</div>
        <div class="del-bank-details">
          <div class="del-bank-name"><%= bank.bankName %></div>
          <div class="del-account-number"><%= bank.accountNumber %></div>
          <div class="del-account-holder"><%= bank.accountHolderName %></div> <!-- Added line -->
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <p class="del-no-banks">No banks saved yet.</p>
  <% } %>
</div>

  <!-- Add Bank Form -->
  <div class="del-bank-form-container">
    <h3 class="del-form-title">Add a New Bank</h3>
    <form id="add-bank-form" class="del-bank-form">
      <div class="del-form-group">
        <label for="bankName" class="del-form-label">Bank Name:</label>
        <select id="bankName" name="bankName" required class="del-form-input">
          <option value="">-- Select Bank --</option>
          <option value="Access Bank">Access Bank</option>
          <option value="ALAT by Wema">ALAT by Wema</option>
          <option value="Citibank Nigeria">Citibank Nigeria</option>
          <option value="Ecobank Nigeria">Ecobank Nigeria</option>
          <option value="Fidelity Bank">Fidelity Bank</option>
          <option value="First Bank of Nigeria">First Bank of Nigeria</option>
          <option value="First City Monument Bank (FCMB)">First City Monument Bank (FCMB)</option>
          <option value="Globus Bank">Globus Bank</option>
          <option value="Guaranty Trust Bank (GTBank)">Guaranty Trust Bank (GTBank)</option>
          <option value="Heritage Bank">Heritage Bank</option>
          <option value="Jaiz Bank">Jaiz Bank</option>
          <option value="Keystone Bank">Keystone Bank</option>
          <option value="Kuda Bank">Kuda Bank</option>
          <option value="Moniepoint Microfinance Bank">Moniepoint Microfinance Bank</option>
          <option value="OPay">OPay</option>
          <option value="Palmpay">Palmpay</option>
          <option value="Parallex Bank">Parallex Bank</option>
          <option value="Polaris Bank">Polaris Bank</option>
          <option value="PremiumTrust Bank">PremiumTrust Bank</option>
          <option value="Providus Bank">Providus Bank</option>
          <option value="Stanbic IBTC Bank">Stanbic IBTC Bank</option>
          <option value="Standard Chartered Bank">Standard Chartered Bank</option>
          <option value="Sterling Bank">Sterling Bank</option>
          <option value="SunTrust Bank">SunTrust Bank</option>
          <option value="Titan Trust Bank">Titan Trust Bank</option>
          <option value="Union Bank of Nigeria">Union Bank of Nigeria</option>
          <option value="United Bank for Africa (UBA)">United Bank for Africa (UBA)</option>
          <option value="Unity Bank">Unity Bank</option>
          <option value="Wema Bank">Wema Bank</option>
          <option value="Zenith Bank">Zenith Bank</option>
        </select>
      </div>

      <div class="del-form-group">
        <label for="accountNumber" class="del-form-label">Account Number:</label>
        <input type="text" id="accountNumber" name="accountNumber" placeholder="1234567890" required class="del-form-input">
      </div>

      <button type="submit" class="del-form-submit">Add Bank</button>
    </form>
    <p id="add-bank-msg" class="del-form-message"></p>
  </div>
</div>

<!-- Withdraw Section -->
<div class="del-section">
  <h2 class="del-section-title">Withdraw</h2>
  <p class="del-withdraw-info">Minimum withdrawable balance: ₦1000</p>

  <div class="del-withdraw-form">
    <% if (user.banks && user.banks.length > 0) { %>
      <div class="del-form-group">
  <label for="withdrawBank" class="del-form-label">Choose a Bank:</label>
  <select id="withdrawBank" class="del-form-input">
    <% user.banks.forEach((bank) => { %>
      <option value="<%= bank._id %>">
        <%= bank.bankName %> (Acct: <%= bank.accountNumber %> - <%= bank.accountHolderName %>)
      </option>
    <% }); %>
  </select>
</div>

      <div class="del-form-group">
        <label for="withdrawAmount" class="del-form-label">Withdrawal Amount (NGN):</label>
        <input type="number" id="withdrawAmount" min="1000" step="100" class="del-form-input" />
      </div>

      <button id="withdraw-btn" class="del-withdraw-btn" disabled>Withdraw Now</button>
      <p id="withdraw-msg" class="del-form-message"></p>
    <% } else { %>
      <p class="del-no-banks">You have no saved banks. Please add one first.</p>
    <% } %>
  </div>
</div>

<% } else { %>
<!-- USER DASHBOARD (non-creator) -->
<div class="del-stats-row">
  <div class="del-stats-card">
    <div class="del-amount">₦<%= totalSubscription %></div>
    <div class="del-label">Total Spent on Subscriptions</div>
    <div class="del-trend"><span class="del-trend-icon">↘</span> 0% Today</div>
  </div>
  
  <div class="del-stats-card">
    <div class="del-amount">₦<%= totalSpecial %></div>
    <div class="del-label">Total Spent on Special Content</div>
    <div class="del-trend"><span class="del-trend-icon">↘</span> 0% Today</div>
  </div>
  
  <div class="del-stats-card del-total-card">
    <div class="del-amount">₦<%= totalSubscription + totalSpecial %></div>
    <div class="del-label">Total Spent</div>
    <div class="del-trend"><span class="del-trend-icon">↘</span> 0% Today</div>
  </div>
</div>
<% } %>

<!-- Transaction History Section -->
<div class="del-section">
  <div class="del-transactions-header">
    <h2 class="del-section-title">Recent Transactions</h2>
    <a href="#" class="del-see-all">See all <span class="del-arrow-icon">→</span></a>
  </div>

  <div class="del-transactions-list">
    <% if (transactions && transactions.length > 0) { %>
      <% transactions.forEach(tx => { %>
        <div class="del-transaction-item">
          <div class="del-transaction-avatar">
            <% if (role === 'creator') { %>
              <img src="<%= tx.user?.profilePicture || '/images/default-profile.png' %>" alt="avatar" class="del-avatar-img">
            <% } else { %>
              <img src="<%= tx.creator?.profilePicture || '/images/default-profile.png' %>" alt="avatar" class="del-avatar-img">
            <% } %>
          </div>
          
          <div class="del-transaction-info">
            <div class="del-transaction-user">
              <% if (role === 'creator') { %>
                <%= tx.user?.username || 'Unknown User' %>
              <% } else { %>
                <%= tx.creator?.username || 'Unknown Creator' %>
              <% } %>
            </div>
            <div class="del-transaction-date">
              <%= tx.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %> | 
              <%= tx.createdAt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
            </div>
          </div>
          
          <div class="del-transaction-details">
            <div class="del-transaction-type <%= tx.type.toLowerCase() %>">
              <%= tx.type.charAt(0).toUpperCase() + tx.type.slice(1) %>
            </div>
            <div class="del-transaction-amount <%= role === 'creator' ? 'credit' : 'debit' %>">
              <%= role === 'creator' ? '+' : '-' %> ₦<%= tx.amount %>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="del-no-transactions">No transactions found</div>
    <% } %>
  </div>
</div>
</div>
<script src="/scripts/utils.js"></script>
<script src="/js/dashboard.js" defer></script>
