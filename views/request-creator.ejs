<div class="rc-request-creator-container">
  <h1>Request to Become a Creator</h1>
  
  <% if (requestPending) { %>
    <p class="rc-info-text">Your creator request is currently being processed. Approval could take 24–72 hours.</p>
  <% } else { %>
    <p class="rc-info-text">Please fill in the details below. Your sensitive information will only be visible to our admin team.</p>
    <p class="rc-info-text">Your photo is processed to verify eligibility, and BVN is deleted after admin review.</p>
  
    <form id="creatorRequestForm" class="rc-form" action="/request-creator" method="POST" enctype="multipart/form-data">
      <!-- BVN -->
      <div>
        <label for="bvn" class="rc-label">BVN</label>
        <input 
          type="text" 
          id="bvn" 
          name="bvn" 
          placeholder="Enter your 11-digit BVN" 
          required 
          pattern="\d{11}"
          class="rc-input"
        />
        <p id="bvnError" class="rc-error rc-hidden">BVN must be an 11-digit number.</p>
      </div>

      <!-- First Name -->
      <div>
        <label for="firstName" class="rc-label">First Name</label>
        <input 
          type="text" 
          id="firstName" 
          name="firstName" 
          placeholder="Enter your first name" 
          required 
          class="rc-input"
        />
      </div>

      <!-- Last Name -->
      <div>
        <label for="lastName" class="rc-label">Last Name</label>
        <input 
          type="text" 
          id="lastName" 
          name="lastName" 
          placeholder="Enter your last name" 
          required 
          class="rc-input"
        />
      </div>

      <!-- Passport Photograph -->
      <div>
        <label class="rc-label">Passport Photograph</label>
        <button type="button" id="openCameraModal" class="rc-button">Open Camera</button>
        <div id="capturedPhotoPreview" class="rc-photo-preview rc-hidden">
          <img id="capturedPhoto" src="" alt="Captured Photo" class="rc-captured-photo"/>
          <button type="button" id="retakeButton" class="rc-button">Retake Photo</button>
        </div>
        <input type="hidden" name="passportPhotoData" id="passportPhotoData" />
        <input type="hidden" name="estimatedAge" id="estimatedAge" />
        <p class="rc-info-text">Capture a clear, passport-style photograph using your device camera.</p>
        <p id="photoMessage" class="rc-photo-message rc-hidden"></p>
      </div>

      <!-- Submit Button -->
      <button type="submit" id="submitButton" class="rc-submit-button" disabled>Submit Creator Request</button>
      <p id="loadingMessage" class="rc-loading-message rc-hidden">Processing your photo, please wait...</p>
    </form>
  <% } %>
</div>

<!-- Modal for Camera Capture -->
<div id="cameraModal" class="rc-modal">
  <div class="rc-modal-content">
    <h2>Camera Capture</h2>
    <video id="modalVideo" autoplay playsinline class="rc-video"></video>
    <br/>
    <button type="button" id="captureButtonModal" class="rc-button">Capture Photo</button>
    <button type="button" id="closeCameraModal" class="rc-button">Cancel</button>
  </div>
</div>
<script src="/scripts/utils.js"></script>
<script src="/js/request-creator.js" defer></script>