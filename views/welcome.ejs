<!-- views/welcome.ejs -->
<div class="wel-page-container">
  <!-- Left Section: Get Started, Logo, and Tagline (Visible on Desktop) -->
  <div class="wel-left-section">
    <div class="wel-signup-desktop">
      <p>
        Don't have an account?
        <span class="wel-getstarted-box">
          <a
            href="/signup<%= typeof ref !== 'undefined' && ref ? `?ref=${encodeURIComponent(ref)}` : '' %><%= creator ? `${typeof ref !== 'undefined' && ref ? '&' : '?'}creator=${encodeURIComponent(creator)}` : '' %>"
            class="wel-signup-link"
          >
            Get Started
          </a>
        </span>
      </p>
    </div>
    <div class="wel-logo-container">
      <a href="/" class="wel-logo-link">
        <!-- Primary logo for desktop -->
        <img
          src="https://storage.googleapis.com/my-public-profile-pictures/logos/elitefans-logo.PNG"
          alt="EliteFans Logo"
          class="wel-site-logo"
        >
        <!-- Secondary logo for desktop -->
        <img
          src="https://storage.googleapis.com/my-public-profile-pictures/logos/Elite%20Fans%20Logo%20(White).png"
          alt="EliteFans White Logo"
          class="wel-site-logo secondary-logo"
        >
      </a>
    </div>
    <h1 class="wel-tagline">
      <% if (typeof creator !== 'undefined' && creator) { %>
        Sign up to subscribe to<br>@<%= creator %>
      <% } else { %>
        Sign up to support your<br>favorite creators
      <% } %>
    </h1>
  </div>

  <!-- Right Section: Original Content -->
  <div class="wel-right-section">
    <div class="wel-signup-options">
      <p>
        <% if (typeof creator !== 'undefined' && creator) { %>
          New to EliteFans?
        <% } else { %>
          Don't have an account?
        <% } %>
        <span class="wel-getstarted-box">
          <a
            href="/signup<%= typeof ref !== 'undefined' && ref ? `?ref=${encodeURIComponent(ref)}` : '' %><%= creator ? `${typeof ref !== 'undefined' && ref ? '&' : '?'}creator=${encodeURIComponent(creator)}` : '' %>"
            class="wel-signup-link"
          >
            <% if (creator) { %>
              Create Account
            <% } else { %>
              Get Started
            <% } %>
          </a>
        </span>
      </p>
    </div>

    <header class="wel-logo-header">
      <a href="/home" class="wel-logo-link">
        <img
          src="https://storage.googleapis.com/my-public-profile-pictures/logos/elitefans-logo.PNG"
          alt="EliteFans Logo"
          class="wel-site-logo"
        >
        <img
          src="https://storage.googleapis.com/my-public-profile-pictures/logos/Elite%20Fans%20Logo%20(White).png"
          alt="EliteFans White Logo"
          class="wel-site-logo secondary-logo"
        >
      </a>
    </header>

    <div class="wel-content-section">
      <div class="wel-welcome-container">
        <% if (typeof creator !== 'undefined' && creator) { %>
          <h2 class="wel-heading">Subscribe to @<%= creator %></h2>
          <p class="wel-subheading">Sign in to your account or create a new one to start supporting this creator</p>
        <% } else { %>
          <h2 class="wel-heading">Welcome Back</h2>
          <p class="wel-subheading">Sign up to meet and support your favorite creators</p>
        <% } %>

        <% if (errorMessage && errorMessage.length > 0) { %>
          <div class="wel-error-message" role="alert">
            <%= errorMessage %>
          </div>
        <% } %>

        <form
          action="/login<%= creator ? `?creator=${encodeURIComponent(creator)}` : '' %>"
          method="POST"
          class="wel-login-form"
        >
          <% if (creator) { %>
            <input type="hidden" name="creator" value="<%= creator %>">
          <% } %>
          <% if (typeof ref !== 'undefined' && ref) { %>
            <input type="hidden" name="ref" value="<%= ref %>">
          <% } %>

          <label for="usernameOrEmail" class="sr-only">Email or Username</label>
          <input
            id="usernameOrEmail"
            type="text"
            name="usernameOrEmail"
            placeholder="Email Address or Username"
            required
            class="wel-input"
          >

          <div class="wel-password-container">
            <label for="password" class="sr-only">Password</label>
            <input
              id="password"
              type="password"
              name="password"
              placeholder="Password"
              required
              class="wel-input"
            >
            <span class="wel-toggle-password" aria-label="Toggle password visibility">👁️</span>
          </div>

          <button type="submit" class="wel-button-login">
            <% if (creator) { %>
              Sign In to Subscribe
            <% } else { %>
              Sign In
            <% } %>
          </button>
        </form>

        <div class="wel-forgot-password">
          <a href="/forgot-password" class="wel-forgot-link">Forgot your password?</a>
        </div>

        <div class="wel-sign-options">
          <p class="wel-sign-text">Or sign in with</p>
          <div class="wel-social-buttons">
            <a
              href="/google<%= creator ? `?creator=${encodeURIComponent(creator)}` : '' %><%= typeof ref !== 'undefined' && ref ? `${creator ? '&' : '?'}ref=${encodeURIComponent(ref)}` : '' %>"
              class="wel-a-sign"
            >
              <i class="fa-brands fa-google wel-social-icon"></i> Google
            </a>
          </div>
        </div>

        <% if (creator) { %>
          <div class="wel-creator-signup-section">
            <div class="wel-divider">
              <span class="wel-divider-text">New to EliteFans?</span>
            </div>
            <a
              href="/signup<%= `?creator=${encodeURIComponent(creator)}` %><%= typeof ref !== 'undefined' && ref ? `&ref=${encodeURIComponent(ref)}` : '' %>"
              class="wel-button-signup"
            >
              Create Account to Subscribe
            </a>
            <p class="wel-creator-benefit">
              Join thousands of fans supporting their favorite creators on EliteFans
            </p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="/scripts/utils.js"></script>
<script src="/js/welcome.js" defer></script>